# ─────────────────────────────────────────────
# Google Gemini (LLM + Embeddings)
# Get your key: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ─────────────────────────────────────────────
# Pinecone (Vector Database)
# Dashboard: https://app.pinecone.io
# Index dimensions must be 768 (Gemini text-embedding-004)
# ─────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=thetechx-knowledge

# ─────────────────────────────────────────────
# Tavily (Web Search)
# Dashboard: https://app.tavily.com
# ─────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ─────────────────────────────────────────────
# Notion (Conversation Memory)
# Integration token + database ID
# See guide.md → Step 4 for setup instructions
# ─────────────────────────────────────────────
NOTION_API_KEY=secret_your_notion_integration_token_here
NOTION_DATABASE_ID=your_32_character_database_id_here

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3001
